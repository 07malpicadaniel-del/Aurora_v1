[Unit]
Description=Aurora v2 Autonomous Commercial Intelligence Daemon
Documentation=https://github.com/07malpicadaniel-del/Aurora_v1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/aurora
# Ajustar la ruta al binario compilado en --release:
ExecStart=%h/.local/bin/aurora-daemon
Environment=RUST_LOG=aurora_daemon=info,aurora_pulse=info,tower_http=info
Environment=AURORA_CONFIG_PATH=%h/.config/aurora/aurora.toml
# Secrets opcionales (ej. AURORA_SMTP_PASSWORD) sin versionar:
EnvironmentFile=-%h/.config/aurora/secrets.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
# Endurecimiento básico compatible con subprocesos chromium/ffmpeg/piper en CPU:
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
